# =============================================================================
# Copy to .env.local for local dev. Every NEXT_PUBLIC_* value is inlined into the
# browser bundle at build time — public by construction.
# =============================================================================

# The canonical origin: metadata, hreflang, sitemap, JSON-LD and llms.txt are built from it.
# Production: https://eapps.site
NEXT_PUBLIC_SITE_URL="http://localhost:7008"

# Google Analytics 4 Measurement ID (G-XXXXXXXX). Empty = analytics off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Search Console verification token, emitted as <meta name="google-site-verification">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# Yandex Webmaster (<meta name="yandex-verification">) — matters for the Russian pages.
NEXT_PUBLIC_YANDEX_VERIFICATION=""
# Bing Webmaster Tools (<meta name="msvalidate.01">) — Bing also feeds Copilot and ChatGPT search.
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
